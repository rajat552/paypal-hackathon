# Application Configuration
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=crawlerpal-super-secret-key-32-chars-long-minimum-required
ACCESS_TOKEN_TTL_MINUTES=60
PAYMENT_CHALLENGE_TTL_MINUTES=10
LOG_LEVEL=INFO

# Database Configuration (supports sqlite+aiosqlite:///./crawlerpal.db or postgresql+psycopg://...)
DATABASE_URL=sqlite+aiosqlite:///./crawlerpal.db

# PayPal Developer Sandbox (Client ID & Secret from developer.paypal.com)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret
PAYPAL_WEBHOOK_ID=optional-sandbox-webhook-id

# AI Provider Configuration (openai, anthropic, or gemini)
AI_PROVIDER=openai
AI_API_KEY=replace-with-ai-key-if-available
AI_MODEL=gpt-4o-mini

# Channel3 Product Data API (Optional for live enrichment; defaults to deterministic fixtures if unset)
CHANNEL3_API_KEY=replace-with-channel3-key

# Frontend Public Variables
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=replace-with-sandbox-client-id

