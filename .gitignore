# ==============================================================================
# PayMesh AI — Repository .gitignore
# Production, Development, CI/CD, and Build Artifact Optimizations
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Sensitive Credentials
# Never commit active secrets, API keys, PayPal tokens, or private certs.
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 2. Python Caches, Bytecode & Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Test, Coverage & Linter Caches
# ------------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 4. Databases, Local State & SQLite WAL Files
# Local persistence databases should not be checked into version control.
# ------------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
crawlerpal.db
test_crawlerpal.db
paymesh.db
test_paymesh.db
server/payments_db.json

# ------------------------------------------------------------------------------
# 5. Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
remotion/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend build outputs & caches
frontend/dist/
frontend/.next/
frontend/out/
.eslintcache
*.tsbuildinfo
vite.config.ts.timestamp-*

# ------------------------------------------------------------------------------
# 6. Remotion Video Generation & Media Renders
# Exclude heavy output renders; keep source code and public assets tracked.
# ------------------------------------------------------------------------------
remotion/out/
remotion/.remotion/
*.mp4
*.webm
*.mov
*.avi

# ------------------------------------------------------------------------------
# 7. Operating System & Editor Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# Editors / IDEs
.idea/
*.swp
*.swo
*~
.vscode/*.log

# ------------------------------------------------------------------------------
# 8. Internal Planning, Specs & Workflow Notes
# ------------------------------------------------------------------------------
workflows.md

# ------------------------------------------------------------------------------
# 9. Remotion Video Generator & Local Media
# Used locally for demo video rendering. Excluded from repository submission.
# ------------------------------------------------------------------------------
remotion/

# ------------------------------------------------------------------------------
# 10. Internal Documentation & Session Notes
# Architecture drafts, session notes, and audit reports excluded from GitHub.
# ------------------------------------------------------------------------------
docs/
understanding.md

# ------------------------------------------------------------------------------
# 11. Temporary & Unused Root Assets
# ------------------------------------------------------------------------------
landing.png
paypal-payments.jpg

# ------------------------------------------------------------------------------
# 12. AI Agent & Tooling Scratch Files
# Local AI assistant scratch files and brain state — never commit these.
# ------------------------------------------------------------------------------
brain/
.gemini/antigravity/brain/

# ------------------------------------------------------------------------------
# 13. Python Script Caches & Test State
# ------------------------------------------------------------------------------
scripts/__pycache__/
server/__pycache__/
backend/tests/__pycache__/
backend/tests/unit/__pycache__/
backend/tests/integration/__pycache__/

# ------------------------------------------------------------------------------
# 14. Assets & Screenshots: Whitelist ONLY files required for README.md
# Everything else in assets/ is strictly ignored to keep repo lightweight.
# ------------------------------------------------------------------------------
assets/*
!assets/screenshots/
assets/screenshots/*

# 7 Root Showcase Screenshots required for README.md
!assets/screenshots/01-agent-workspace.png
!assets/screenshots/02-l402-challenge.png
!assets/screenshots/03-unlocked-intelligence.png
!assets/screenshots/04-spending-policy.png
!assets/screenshots/05-marketplace-catalogue.png
!assets/screenshots/06-financial-ledger.png
!assets/screenshots/07-merchant-studio.png

# Subdirectories required for README.md
!assets/screenshots/tour/
!assets/screenshots/404/

# Ignore all other files inside tour/ and 404/
assets/screenshots/tour/*
assets/screenshots/404/*

# Exact 2 Subdirectory Showcase Screenshots required for README.md
!assets/screenshots/tour/00_url_click_tour_first.png
!assets/screenshots/404/01_404_desktop.png

# ------------------------------------------------------------------------------
# 15. Hackathon Video Production, Storyboards, Scripts & Internal QA Reports
# Generated during video demo planning and QA; excluded to keep repository clean.
# ------------------------------------------------------------------------------
FINAL_APPLICATION_QA_REPORT.md
nextwork.md
PayMesh_AI_Shot_List*.md
PayMesh_AI_Storyboard*.md
PayMesh_AI_Video_Production_Report.md
PayMesh_AI_Video_QA_Report.md
